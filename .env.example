# ── App (Vercel) ──────────────────────────────────────────────
# Copy to .env.local for local dev. NEVER commit real keys.

# AI providers — fill at least one. Without any key the agents return demo answers.
# Choose the main provider + fallback in Settings → Penyedia AI.
GEMINI_API_KEY=        # free tier — https://aistudio.google.com/apikey
GROQ_API_KEY=          # free tier — https://console.groq.com/keys
OPENAI_API_KEY=        # paid (also used by the render worker for TTS)
ANTHROPIC_API_KEY=     # paid, only provider with live web search for Scout/Researcher
# Optional model overrides (also editable in Settings):
# GEMINI_MODEL=gemini-3.8-flash
# GROQ_MODEL=openai/gpt-oss-120b
# OPENAI_MODEL=gpt-5-mini
# ANTHROPIC_MODEL=claude-sonnet-5-5

# Supabase — without it data lives in memory (local demo only)
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Login passcode for the app (strongly recommended in production)
APP_PASSCODE=
# SESSION_SALT=any-random-string

# Vercel Cron sends this as a Bearer token to /api/cron/daily
CRON_SECRET=

# Push notifications — generate once: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Optional: secret for internal step chaining (falls back to CRON_SECRET / APP_PASSCODE)
# INTERNAL_SECRET=

# Render worker (Railway). Leave empty to preview videos in the browser only.
RENDER_WORKER_URL=
RENDER_WORKER_SECRET=
# Public URL of this app, used for the worker callback (auto-detected on Vercel)
# APP_URL=https://runai.vercel.app

# ── Render worker (Railway) ───────────────────────────────────
# RENDER_WORKER_SECRET=   (same value as above)
# SUPABASE_URL=           (same as NEXT_PUBLIC_SUPABASE_URL)
# SUPABASE_SERVICE_ROLE_KEY=
# OPENAI_API_KEY=         (OpenAI TTS)  — or —
# ELEVENLABS_API_KEY=     (ElevenLabs TTS)
# RENDER_CONCURRENCY=2
